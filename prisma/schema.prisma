// =============================================================================
//  Pros-Link platform — Prisma schema
//
//  The system of record for Pros-Link's customer service, sales and CRM
//  platform: conversations on the web assistant and WhatsApp, leads, quote
//  requests, customers and the machines they own, service tickets, the product
//  catalogue, knowledge, messaging and administration.
//
//  TENANCY. Every table the application writes carries a `department` column,
//  and every record is stamped `PROSLINK` (see `src/config/brand.ts`). Every
//  query filters on it with strict equality. Pros-Link is meant to run on its
//  own database; the column is defence in depth, so that if the application is
//  ever pointed at a database holding another application's data, none of that
//  data is shown or changed. Columns added for this are nullable with no
//  default: a row written by anything else stays invisible.
//
//  LEGACY. The models at the end of the file belong to the application this
//  platform was built from. They are kept so the tables survive — deleting a
//  model here makes the next `prisma migrate dev` drop its table — and nothing
//  in the application reads or writes them. Remove them deliberately, with an
//  export and a migration (see docs/DEPLOYMENT.md).
//
//  Model names are neutral; `@@map` keeps the existing table names, so a rename
//  here never renames a table.
// =============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  // Pooled connection (PgBouncer) — used by the running application, which
  // opens and closes many short-lived connections.
  url      = env("DATABASE_URL")
  // Direct, unpooled connection — required for migrations, which need session
  // state that a transaction-mode pooler does not preserve. Falls back to
  // DATABASE_URL when unset, so a plain non-pooled setup still works.
  directUrl = env("DIRECT_DATABASE_URL")
}

// ---------------------------------------------------------------- Enums -----

/// The tenant that owns a record. PROSLINK is this deployment. MARKETING and
/// INSTITUTE mark legacy rows written by an earlier application; they are never
/// shown and never modified.
enum Department {
  MARKETING
  INSTITUTE
  PROSLINK
}

enum Language {
  EN
  UR
  UR_ROMAN
  PA
}

/// Where a conversation is physically taking place. The engine, the routing and
/// the knowledge are identical across channels — only the transport differs.
enum Channel {
  WEB
  WHATSAPP
}

/// Console role. Permissions for each are defined in `src/lib/permissions.ts`.
/// GUEST, CUSTOMER, STUDENT, AGENT and INSTRUCTOR are legacy values.
enum UserRole {
  GUEST
  CUSTOMER
  STUDENT
  AGENT
  INSTRUCTOR
  ADMIN
  SUPER_ADMIN
  SALES
  SUPPORT
  TECHNICIAN
  VIEWER
}

enum ChatRole {
  USER
  ASSISTANT
  SYSTEM
}

/// Which surface captured a lead or request. CHATBOT is the web assistant.
enum LeadSource {
  CHATBOT
  WHATSAPP
  WEBSITE
  REFERRAL
  WALK_IN
  SOCIAL
  PHONE
  OTHER
}

enum Priority {
  LOW
  NORMAL
  HIGH
  URGENT
}

/// Sales pipeline: NEW → CONTACTED → QUALIFIED → QUOTE_REQUESTED → QUOTED →
/// NEGOTIATION → WON | LOST. SPAM and OPTED_OUT close a lead outside the
/// pipeline. PROPOSAL_SENT, HOT, FOLLOW_UP and SUPPORT are legacy values that
/// the application no longer assigns.
enum LeadStage {
  NEW
  CONTACTED
  QUALIFIED
  PROPOSAL_SENT
  NEGOTIATION
  WON
  LOST
  HOT
  FOLLOW_UP
  SUPPORT
  SPAM
  OPTED_OUT
  QUOTE_REQUESTED
  QUOTED
}

/// Lead score band. Thresholds live in the chatbot configuration.
enum LeadTemperature {
  COLD
  WARM
  HOT
  HIGH_PRIORITY
}

/// Where a conversation came from, as opposed to `Channel` (where it happens)
/// and `LeadSource` (which surface captured the lead).
enum TrafficSource {
  META_ADS
  GOOGLE_ADS
  WEBSITE
  QR_CODE
  INSTAGRAM
  FACEBOOK
  TIKTOK
  DIRECT_WHATSAPP
  REFERRAL
  CAMPAIGN
  BROADCAST
  OTHER
}

enum OptInStatus {
  UNKNOWN
  OPTED_IN
  OPTED_OUT
}

/// Legacy — kept for the retained admissions table.
enum AdmissionStage {
  INQUIRY
  CONTACTED
  COUNSELLED
  APPLIED
  FEE_PENDING
  ENROLLED
  DROPPED
  LOST
}

/// Ticket lifecycle. OPEN is shown as "New".
enum TicketStatus {
  OPEN
  IN_PROGRESS
  WAITING_CUSTOMER
  RESOLVED
  CLOSED
  ASSIGNED
  TECHNICIAN_DISPATCHED
}

/// INSTALLATION, TECHNICAL, MAINTENANCE, REPAIR, SERVICE and PARTS are service
/// tickets; COMPLAINT, CALLBACK, BILLING, SALES and GENERAL are support requests.
enum TicketCategory {
  TECHNICAL
  BILLING
  SALES
  COMPLAINT
  GENERAL
  INSTALLATION
  MAINTENANCE
  REPAIR
  SERVICE
  PARTS
  CALLBACK
}

enum MeetingMode {
  OFFICE
  ZOOM
  GOOGLE_MEET
  WHATSAPP
}

enum MeetingStatus {
  REQUESTED
  CONFIRMED
  RESCHEDULED
  COMPLETED
  CANCELLED
  NO_SHOW
}

/// REQUESTED is a customer's request for a quotation; DRAFT onwards is the
/// quotation the team prepares.
enum QuoteStatus {
  DRAFT
  SENT
  ACCEPTED
  REJECTED
  EXPIRED
  REQUESTED
}

enum ProjectStatus {
  DISCOVERY
  IN_PROGRESS
  REVIEW
  DELIVERED
  ON_HOLD
  CANCELLED
}

enum BatchStatus {
  PLANNED
  ENROLLING
  RUNNING
  COMPLETED
  CANCELLED
}

enum EnrollmentStatus {
  ACTIVE
  COMPLETED
  DROPPED
  SUSPENDED
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  EXCUSED
}

enum FeeStatus {
  PENDING
  PARTIAL
  PAID
  OVERDUE
  WAIVED
}

enum KnowledgeKind {
  FAQ
  ARTICLE
  SERVICE
  COURSE
  POLICY
  DOCUMENT
}

enum PublishState {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum MediaKind {
  IMAGE
  DOCUMENT
  VIDEO
  AUDIO
  OTHER
}

enum ActivityType {
  NOTE
  FOLLOW_UP
  REMINDER
  CALL
  EMAIL
  WHATSAPP
  MEETING
  STAGE_CHANGE
  ASSIGNMENT
  STATUS_CHANGE
}

enum NotificationChannel {
  EMAIL
  SMS
  WHATSAPP
  PUSH
  IN_APP
}

enum NotificationStatus {
  QUEUED
  SENT
  FAILED
  READ
}

enum BroadcastStatus {
  DRAFT
  SCHEDULED
  SENDING
  SENT
  FAILED
}

/// Lifecycle of a message template, mirroring Meta's own review states.
///
/// `DRAFT` is the one state Meta does not have: a template written here but
/// never submitted for approval. Everything from `PENDING` onwards is Meta's
/// verdict, refreshed by a sync — and only `APPROVED` may actually be sent.
enum TemplateStatus {
  DRAFT
  PENDING
  APPROVED
  REJECTED
  PAUSED
  DISABLED
}

/// Meta's template categories. The category decides which pricing conversation
/// the template opens, and Meta will not let it change after approval.
enum TemplateCategory {
  MARKETING
  UTILITY
  AUTHENTICATION
}

/// Per-recipient delivery state inside a broadcast.
///
/// `SENT` means Meta accepted the message, which is not the same as it having
/// arrived — `DELIVERED` and `READ` are set only when Meta's webhook says so.
enum BroadcastRecipientStatus {
  PENDING
  SENT
  DELIVERED
  READ
  FAILED
  SKIPPED
}

enum LogLevel {
  DEBUG
  INFO
  WARN
  ERROR
}

/// What staff have confirmed about a product's availability. ON_REQUEST — the
/// default — means the assistant says the team will confirm; it never claims
/// stock that nobody entered.
enum ProductAvailability {
  IN_STOCK
  LIMITED_STOCK
  OUT_OF_STOCK
  ON_ORDER
  ON_REQUEST
  DISCONTINUED
}

enum CustomerStatus {
  PROSPECT
  ACTIVE
  INACTIVE
}

enum ConversationStatus {
  OPEN
  CLOSED
}

// -------------------------------------------------- Identity & access --------

model User {
  id           String    @id @default(cuid())
  name         String
  email        String?   @unique
  phone        String?   @unique
  cnic         String?   @unique
  passwordHash String?
  role         UserRole  @default(GUEST)
  /// Tenant the account belongs to. Only PROSLINK accounts can sign in.
  department   Department?
  language     Language  @default(EN)
  avatarUrl    String?
  isActive     Boolean   @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  roleId String?
  rbac   Role?   @relation(fields: [roleId], references: [id], onDelete: SetNull)

  conversations         Conversation[]
  assignedConversations Conversation[]   @relation("ConversationAssignee")
  assignedLeads         Lead[]           @relation("LeadOwner")
  assignedAdmission     LegacyAdmission[] @relation("AdmissionOwner")
  assignedTickets       Ticket[]         @relation("TicketAssignee")
  reportedTickets       Ticket[]         @relation("TicketReporter")
  hostedMeetings        Meeting[]        @relation("MeetingHost")
  activities            CrmActivity[]    @relation("ActivityOwner")
  ownedCustomers        Customer[]       @relation("CustomerOwner")
  ownedQuotes           Quote[]          @relation("QuoteOwner")
  notifications         Notification[]
  systemLogs            SystemLog[]
  broadcasts            Broadcast[]      @relation("BroadcastAuthor")
  customer              Customer?
  student               LegacyStudent?
  faculty               LegacyFaculty?

  @@index([role])
  @@index([department])
  @@map("users")
}

/// Named role, mirrored from `src/lib/permissions.ts` by the seed so the
/// matrix can also be read from the database.
model Role {
  id          String  @id @default(cuid())
  key         String  @unique
  name        String
  description String?
  department  Department?
  /// System roles cannot be deleted from the admin console.
  isSystem    Boolean @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  users       User[]
  permissions RolePermission[]

  @@map("roles")
}

/// A single capability, e.g. `crm.leads.manage`.
model Permission {
  id          String  @id @default(cuid())
  key         String  @unique
  group       String
  description String?
  createdAt   DateTime @default(now())

  roles RolePermission[]

  @@index([group])
  @@map("permissions")
}

model RolePermission {
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

// ------------------------------------------------------------ Conversations --

model Conversation {
  id        String      @id @default(cuid())
  reference String      @unique
  /// Which surface this thread arrived on — the web assistant or WhatsApp.
  channel   Channel     @default(WEB)
  department Department?
  userId    String?
  user      User?       @relation(fields: [userId], references: [id], onDelete: SetNull)
  title     String?
  language  Language    @default(EN)
  summary   String?
  /// WhatsApp sender (E.164 without `+`, as Meta reports it). Null on the web.
  contactPhone String?
  /// WhatsApp profile name, so the console shows a person rather than a number.
  contactName  String?
  /// What the customer has told the assistant, the records it produced and the
  /// engine's memory. Shape: `CaptureState` in `lib/capture.ts`.
  capture   Json?
  /// Set when a human takes over from the assistant.
  handedOff Boolean     @default(false)
  handedOffAt  DateTime?
  handoverTeam String?
  /// Set by staff: the assistant stays silent while a person replies.
  botPaused Boolean     @default(false)
  /// Attribution, captured from the first message of the thread.
  trafficSource TrafficSource?
  campaign  String?
  adId      String?
  referral  Json?
  rating    Int?
  /// Inbox state.
  status        ConversationStatus @default(OPEN)
  assigneeId    String?
  assignee      User?       @relation("ConversationAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  customerId    String?
  customer      Customer?   @relation(fields: [customerId], references: [id], onDelete: SetNull)
  /// The assistant's latest intent label for the thread, e.g. REPAIR or QUOTE.
  intent        String?
  tags          String[]    @default([])
  /// Last customer message; the thread is unread while it is newer than `readAt`.
  lastInboundAt DateTime?
  readAt        DateTime?
  closedAt      DateTime?
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  messages   Message[]
  tickets    Ticket[]
  leads      Lead[]
  quotes     Quote[]
  admissions LegacyAdmission[]
  meetings   Meeting[]
  botEvents  BotEvent[]

  @@index([userId])
  @@index([department])
  @@index([createdAt])
  @@index([channel, contactPhone, updatedAt])
  @@index([trafficSource])
  @@index([department, status, updatedAt])
  @@index([assigneeId])
  @@map("conversations")
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  role           ChatRole
  content        String
  department     Department?
  language       Language?
  tokens         Int?
  latencyMs      Int?
  /// Provider message id (WhatsApp `wamid.…`). Unique, which is what makes
  /// webhook redelivery idempotent.
  externalId     String?      @unique
  /// Staff member who wrote an ASSISTANT message from the console. Null for the
  /// assistant itself.
  authorId       String?
  /// WhatsApp media the customer sent: Meta's media id, the kind and MIME type.
  /// The file is fetched through the console on demand, never stored here.
  mediaId        String?
  mediaType      String?
  mediaMime      String?
  createdAt      DateTime     @default(now())

  @@index([conversationId])
  @@map("messages")
}

// ======================================================================= CRM ==

model Lead {
  id           String     @id @default(cuid())
  reference    String     @unique
  department   Department?
  name         String
  company      String?
  phone        String
  whatsapp     String?
  email        String?
  businessType String?
  /// Legacy catalogue slug; unused by this application.
  serviceSlug  String?
  budget       String?
  timeline     String?
  requirements String
  website      String?
  country      String?
  city         String?
  /// What the lead is interested in, in words — "Photocopier / MFP", "Toner".
  subService   String?
  productCategoryId String?
  productCategory   ProductCategory? @relation(fields: [productCategoryId], references: [id], onDelete: SetNull)
  productId    String?
  product      Product?   @relation(fields: [productId], references: [id], onDelete: SetNull)
  quantity     String?
  /// Phone call, WhatsApp or email.
  preferredContact String?
  /// The assistant's intent classification, e.g. PHOTOCOPIER.
  intent       String?
  businessGoal String?
  challenge    String?
  companySize  String?
  source       LeadSource @default(CHATBOT)
  stage        LeadStage  @default(NEW)
  priority     Priority   @default(NORMAL)
  /// 0–100, recomputed on every turn from the weights in the chatbot config.
  score        Int        @default(0)
  temperature  LeadTemperature @default(COLD)
  scoreReasons String[]
  trafficSource TrafficSource?
  campaign     String?
  adId         String?
  /// Team key from the chatbot config (SALES, CORPORATE, SERVICE…).
  assignedTeam String?
  conversationSummary String?
  nextAction   String?
  lastMessage  String?
  lastMessageAt DateTime?
  optInStatus  OptInStatus @default(UNKNOWN)
  followUpCount  Int       @default(0)
  lastFollowUpAt DateTime?
  estimatedValue Decimal? @db.Decimal(12, 2)
  lostReason   String?
  ownerId      String?
  owner        User?      @relation("LeadOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  conversationId String?
  conversation   Conversation? @relation(fields: [conversationId], references: [id], onDelete: SetNull)
  customerId   String?
  customer     Customer?  @relation(fields: [customerId], references: [id], onDelete: SetNull)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  quotes   Quote[]
  meetings Meeting[]

  @@index([stage])
  @@index([createdAt])
  @@index([ownerId])
  @@index([temperature])
  @@index([trafficSource])
  @@index([department, stage])
  @@index([phone])
  @@map("marketing_leads")
}

model Customer {
  id         String   @id @default(cuid())
  reference  String   @unique
  department Department?
  name       String
  company    String?
  phone      String
  whatsapp   String?
  email      String?
  address    String?
  city       String?
  industry   String?
  notes      String?
  isActive   Boolean  @default(true)
  status     CustomerStatus @default(PROSPECT)
  source     LeadSource?
  ownerId    String?
  owner      User?    @relation("CustomerOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  lastInteractionAt DateTime?
  userId     String?  @unique
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  leads          Lead[]
  quotes         Quote[]
  tickets        Ticket[]
  conversations  Conversation[]
  assets         CustomerAsset[]
  legacyProjects LegacyProject[]

  @@index([name])
  @@index([department, name])
  @@index([phone])
  @@map("customers")
}

/// A machine or product a customer owns — what service tickets are raised against.
model CustomerAsset {
  id            String     @id @default(cuid())
  department    Department
  customerId    String
  customer      Customer   @relation(fields: [customerId], references: [id], onDelete: Cascade)
  productId     String?
  product       Product?   @relation(fields: [productId], references: [id], onDelete: SetNull)
  /// What the customer calls it when no catalogue product matches.
  label         String
  brand         String?
  model         String?
  serialNumber  String?
  installedAt   DateTime?  @db.Date
  warrantyUntil DateTime?  @db.Date
  location      String?
  notes         String?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  @@index([customerId])
  @@index([serialNumber])
  @@map("customer_assets")
}

/// A customer's request for a quotation (REQUESTED) and the quotation the team
/// prepares from it (DRAFT → SENT → ACCEPTED / REJECTED / EXPIRED).
model Quote {
  id          String      @id @default(cuid())
  reference   String      @unique
  department  Department?
  title       String
  status      QuoteStatus @default(DRAFT)
  currency    String      @default("PKR")
  subtotal    Decimal     @default(0) @db.Decimal(12, 2)
  discount    Decimal     @default(0) @db.Decimal(12, 2)
  tax         Decimal     @default(0) @db.Decimal(12, 2)
  total       Decimal     @default(0) @db.Decimal(12, 2)
  /// Line items: [{ description, quantity, unitPrice }]
  items       Json?
  notes       String?
  productCategoryId String?
  productCategory   ProductCategory? @relation(fields: [productCategoryId], references: [id], onDelete: SetNull)
  productId   String?
  product     Product?    @relation(fields: [productId], references: [id], onDelete: SetNull)
  quantity    String?
  requirements String?
  budget      String?
  preferredContact String?
  city        String?
  source      LeadSource?
  ownerId     String?
  owner       User?       @relation("QuoteOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  conversationId String?
  conversation   Conversation? @relation(fields: [conversationId], references: [id], onDelete: SetNull)
  validUntil  DateTime?
  sentAt      DateTime?
  decidedAt   DateTime?
  leadId      String?
  lead        Lead?       @relation(fields: [leadId], references: [id], onDelete: SetNull)
  customerId  String?
  customer    Customer?   @relation(fields: [customerId], references: [id], onDelete: SetNull)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@index([status])
  @@index([department, status])
  @@map("quotes")
}

// ================================================================= Catalogue ==

model ProductCategory {
  id          String     @id @default(cuid())
  department  Department
  slug        String
  name        String
  description String?
  /// Lucide icon name used by the catalogue and the web assistant, e.g. "printer".
  icon        String?
  sortOrder   Int        @default(0)
  isActive    Boolean    @default(true)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  products Product[]
  leads    Lead[]
  quotes   Quote[]

  @@unique([department, slug])
  @@index([department, isActive, sortOrder])
  @@map("product_categories")
}

/// A manufacturer brand. The assistant names a brand only when staff have
/// verified it (`isVerified`) and made it active.
model Brand {
  id          String     @id @default(cuid())
  department  Department
  slug        String
  name        String
  description String?
  logoUrl     String?
  website     String?
  isVerified  Boolean    @default(false)
  isActive    Boolean    @default(false)
  sortOrder   Int        @default(0)
  notes       String?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  products Product[]

  @@unique([department, slug])
  @@map("brands")
}

/// A catalogue product. Only PUBLISHED products reach customers, and only the
/// specifications, availability and documents staff entered.
model Product {
  id             String       @id @default(cuid())
  department     Department
  slug           String
  sku            String?
  name           String
  categoryId     String?
  category       ProductCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  brandId        String?
  brand          Brand?       @relation(fields: [brandId], references: [id], onDelete: SetNull)
  model          String?
  summary        String?
  description    String?
  images         String[]     @default([])
  /// [{ label, value }]
  specifications Json?
  features       String[]     @default([])
  /// [{ title, url }] — brochures, datasheets, manuals.
  documents      Json?
  availability   ProductAvailability @default(ON_REQUEST)
  status         PublishState @default(DRAFT)
  isFeatured     Boolean      @default(false)
  sortOrder      Int          @default(0)
  keywords       String[]     @default([])
  relatedIds     String[]     @default([])
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  leads   Lead[]
  quotes  Quote[]
  tickets Ticket[]
  assets  CustomerAsset[]

  @@unique([department, slug])
  @@unique([department, sku])
  @@index([department, status, categoryId])
  @@map("products")
}

// ================================================================= Knowledge ==

/// The assistant's knowledge base, edited from Admin → Knowledge.
model KnowledgeArticle {
  id          String        @id @default(cuid())
  slug        String        @unique
  department  Department?
  kind        KnowledgeKind @default(FAQ)
  category    String
  question    String
  answer      String
  keywords    String[]
  language    Language      @default(EN)
  state       PublishState  @default(PUBLISHED)
  /// Bumped on every edit.
  version     Int           @default(1)
  indexedAt   DateTime?
  sortOrder   Int           @default(0)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([category])
  @@index([state])
  @@index([department, state])
  @@map("knowledge_base_marketing")
}

/// Documents, downloads and images referenced by the knowledge base.
model MediaAsset {
  id          String     @id @default(cuid())
  department  Department
  kind        MediaKind  @default(DOCUMENT)
  title       String
  description String?
  url         String
  mimeType    String?
  sizeBytes   Int?
  isDownload  Boolean    @default(false)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@index([department])
  @@map("media_assets")
}

// ============================================================ OPERATIONS ====

/// Service tickets (installation, technical support, maintenance, repair,
/// service, parts) and support requests (complaints, callbacks, billing,
/// general), told apart by `category`.
model Ticket {
  id             String         @id @default(cuid())
  reference      String         @unique
  department     Department
  category       TicketCategory @default(GENERAL)
  status         TicketStatus   @default(OPEN)
  priority       Priority       @default(NORMAL)
  subject        String
  description    String
  contactName    String?
  contactPhone   String?
  contactEmail   String?
  company        String?
  city           String?
  address        String?
  machineType    String?
  machineBrand   String?
  machineModel   String?
  serialNumber   String?
  productId      String?
  product        Product?       @relation(fields: [productId], references: [id], onDelete: SetNull)
  preferredDate  DateTime?      @db.Date
  preferredTime  String?
  /// WhatsApp media the customer sent with the request:
  /// [{ mediaId, type, mime, caption, messageId }]
  attachments    Json?
  source         LeadSource?
  resolution     String?
  resolvedAt     DateTime?
  dispatchedAt   DateTime?
  closedAt       DateTime?
  reporterId     String?
  reporter       User?          @relation("TicketReporter", fields: [reporterId], references: [id], onDelete: SetNull)
  assigneeId     String?
  assignee       User?          @relation("TicketAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  customerId     String?
  customer       Customer?      @relation(fields: [customerId], references: [id], onDelete: SetNull)
  conversationId String?
  conversation   Conversation?  @relation(fields: [conversationId], references: [id], onDelete: SetNull)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@index([status])
  @@index([department])
  @@index([department, status])
  @@index([assigneeId])
  @@map("tickets")
}

/// Appointments — product demonstrations and site visits the customer asked for.
model Meeting {
  id             String        @id @default(cuid())
  reference      String        @unique
  department     Department
  name           String
  phone          String
  email          String?
  businessName   String?
  topic          String?
  mode           MeetingMode   @default(ZOOM)
  status         MeetingStatus @default(REQUESTED)
  preferredDate  DateTime      @db.Date
  preferredTime  String
  confirmedAt    DateTime?
  meetingLink    String?
  notes          String?
  hostId         String?
  host           User?         @relation("MeetingHost", fields: [hostId], references: [id], onDelete: SetNull)
  leadId         String?
  lead           Lead?         @relation(fields: [leadId], references: [id], onDelete: SetNull)
  conversationId String?
  conversation   Conversation? @relation(fields: [conversationId], references: [id], onDelete: SetNull)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([status])
  @@index([preferredDate])
  @@map("meetings")
}

/// Polymorphic CRM timeline: notes, follow-ups, reminders, assignments and
/// status changes against a lead, customer, ticket, quote or conversation.
model CrmActivity {
  id          String       @id @default(cuid())
  department  Department
  type        ActivityType @default(NOTE)
  /// "Lead" | "Customer" | "Ticket" | "Quote" | "Conversation"
  entityType  String
  entityId    String
  body        String
  dueAt       DateTime?
  completedAt DateTime?
  ownerId     String?
  owner       User?        @relation("ActivityOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@index([entityType, entityId])
  @@index([dueAt])
  @@map("crm_activities")
}

/// A person who has messaged the WhatsApp business number.
model WhatsappContact {
  id             String      @id @default(cuid())
  /// Meta's `wa_id` — E.164 digits with no leading `+`, e.g. `923001234567`.
  waId           String      @unique
  /// Same number in display form (`+923001234567`).
  phone          String
  profileName    String?
  department     Department?
  lastInboundAt  DateTime?
  lastOutboundAt DateTime?
  /// True after the contact sends STOP. Blocks broadcasts, not replies.
  optedOut       Boolean     @default(false)
  /// Set by staff to make the assistant ignore a number entirely.
  isBlocked      Boolean     @default(false)
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  broadcastRows  BroadcastRecipient[]

  @@index([department])
  @@index([lastInboundAt])
  @@map("whatsapp_contacts")
}

/// A WhatsApp message template, as Meta knows it — a local mirror so the
/// console can list and compose without a Graph call on every page load.
model WhatsappTemplate {
  id          String     @id @default(cuid())
  /// Local, human-chosen key, independent of Meta's naming rules.
  key         String     @unique
  /// The name Meta knows it by: lowercase, digits and underscores only.
  metaName    String
  metaId      String?    @unique
  department  Department?
  name        String
  language    Language   @default(EN)
  /// Meta's own language code (`en`, `en_US`, `ur`).
  languageCode String    @default("en")
  category    TemplateCategory @default(UTILITY)
  status      TemplateStatus   @default(DRAFT)
  /// The BODY component's text, with Meta's `{{1}}` placeholders intact.
  body        String
  headerText  String?
  /// TEXT, IMAGE, VIDEO, DOCUMENT — or null for no header.
  headerFormat String?
  footerText  String?
  buttons     Json?
  /// Every component exactly as Meta returned it.
  components  Json?
  /// Placeholder names in order — a label for the composer only.
  variables   String[]
  rejectedReason String?
  qualityScore String?
  syncedAt    DateTime?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  broadcasts Broadcast[]

  @@unique([metaName, languageCode])
  @@index([department])
  @@index([status])
  @@map("whatsapp_templates")
}

model Broadcast {
  id          String          @id @default(cuid())
  reference   String          @unique
  department  Department
  channel     NotificationChannel @default(WHATSAPP)
  status      BroadcastStatus @default(DRAFT)
  title       String
  /// The template body with this broadcast's parameters substituted in.
  body        String
  /// Saved audience filter, e.g. { stage: "QUALIFIED", source: "WHATSAPP" }.
  audience    Json?
  templateId  String?
  template    WhatsappTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)
  templateName String?
  languageCode String?
  /// Public URL of the header media for a template whose header is media.
  headerMediaUrl String?
  /// How each `{{n}}` was filled.
  parameters  Json?
  scheduledAt DateTime?
  startedAt   DateTime?
  sentAt      DateTime?
  recipients  Int             @default(0)
  sent        Int             @default(0)
  delivered   Int             @default(0)
  readCount   Int             @default(0)
  failed      Int             @default(0)
  error       String?
  createdById String?
  createdBy   User?           @relation("BroadcastAuthor", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  recipientRows BroadcastRecipient[]

  @@index([status])
  @@map("broadcasts")
}

/// One row per person a broadcast was sent to — the key delivery receipts
/// arrive on, and the record that makes a resumed run safe.
model BroadcastRecipient {
  id          String    @id @default(cuid())
  broadcastId String
  broadcast   Broadcast @relation(fields: [broadcastId], references: [id], onDelete: Cascade)
  contactId   String?
  contact     WhatsappContact? @relation(fields: [contactId], references: [id], onDelete: SetNull)
  waId        String
  phone       String
  name        String?
  parameters  String[]
  status      BroadcastRecipientStatus @default(PENDING)
  messageId   String?   @unique
  error       String?
  sentAt      DateTime?
  deliveredAt DateTime?
  readAt      DateTime?
  createdAt   DateTime  @default(now())

  @@unique([broadcastId, waId])
  @@index([broadcastId, status])
  @@map("broadcast_recipients")
}

/// Team notifications. IN_APP rows belong to one staff member (`userId`) and
/// are unread until READ; EMAIL rows are queued for delivery.
model Notification {
  id         String              @id @default(cuid())
  department Department?
  channel    NotificationChannel
  status     NotificationStatus  @default(QUEUED)
  to         String
  subject    String?
  body       String
  /// Deep link into the admin console, e.g. /admin/crm/leads/<id>.
  link       String?
  userId     String?
  user       User?               @relation(fields: [userId], references: [id], onDelete: SetNull)
  sentAt     DateTime?
  error      String?
  createdAt  DateTime            @default(now())

  @@index([status])
  @@index([department])
  @@index([userId, status])
  @@map("notifications")
}

/// Key/value application settings. Keys are namespaced by tenant
/// (`proslink.company`, `proslink.bot.menu`).
model Setting {
  id          String      @id @default(cuid())
  key         String      @unique
  department  Department?
  group       String      @default("general")
  value       Json
  description String?
  isSecret    Boolean     @default(false)
  updatedAt   DateTime    @updatedAt

  @@index([group])
  @@map("settings")
}

/// Audit log: who did what to which record, with before/after values in
/// `metadata` for changes.
model SystemLog {
  id         String      @id @default(cuid())
  level      LogLevel    @default(INFO)
  department Department?
  action     String
  entity     String?
  entityId   String?
  message    String?
  metadata   Json?
  ipAddress  String?
  userAgent  String?
  userId     String?
  user       User?       @relation(fields: [userId], references: [id], onDelete: SetNull)
  createdAt  DateTime    @default(now())

  @@index([action])
  @@index([createdAt])
  @@index([level])
  @@map("system_logs")
}

/// One thing the assistant did or observed — a menu opened, a quote requested,
/// a handover. Analytics count these rows. `type` is a string on purpose.
model BotEvent {
  id             String        @id @default(cuid())
  department     Department?
  type           String
  channel        Channel       @default(WHATSAPP)
  conversationId String?
  conversation   Conversation? @relation(fields: [conversationId], references: [id], onDelete: SetNull)
  leadId         String?
  intent         String?
  team           String?
  value          String?
  metadata       Json?
  createdAt      DateTime      @default(now())

  @@index([type, createdAt])
  @@index([conversationId])
  @@index([department, type, createdAt])
  @@map("bot_events")
}

/// Daily rollup for dashboards and reports.
model AnalyticsDaily {
  id                String     @id @default(cuid())
  date              DateTime   @db.Date
  department        Department?
  conversations     Int        @default(0)
  messages          Int        @default(0)
  leads             Int        @default(0)
  admissions        Int        @default(0)
  meetings          Int        @default(0)
  tickets           Int        @default(0)
  revenue           Decimal    @default(0) @db.Decimal(12, 2)
  conversionRate    Float      @default(0)
  avgResponseMs     Int        @default(0)
  satisfactionScore Float      @default(0)
  createdAt         DateTime   @default(now())

  @@unique([date, department])
  @@index([date])
  @@map("analytics_daily")
}

