# =============================================================================
#  Pros-Link platform — environment configuration
# =============================================================================
#  Copy this file to `.env` and fill in real values. NEVER commit `.env`.
#  Secrets live only here (or in the host's environment panel) — never in the
#  code, the database, or anything sent to the browser. Only variables that
#  start with NEXT_PUBLIC_ reach the browser, and none of them is a secret.
#
#  Contact details (phone, WhatsApp number, email, address, hours, offices) are
#  NOT configured here: they are entered in Admin ▸ Settings ▸ Company profile.
# -----------------------------------------------------------------------------

# --- Application ------------------------------------------------------------
NODE_ENV=development
APP_NAME="Pros-Link"
APP_URL=http://localhost:3000
# Public base URL the browser uses (exposed to the client).
NEXT_PUBLIC_APP_URL=http://localhost:3000
# In production both are https://ai.pros-link.com. Next bakes NEXT_PUBLIC_APP_URL
# into the build, so it must be set before `npm run build`, not only at runtime.

# --- Database (PostgreSQL) --------------------------------------------------
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL=postgresql://proslink:change-me@localhost:5432/proslink?schema=public
# Non-pooled connection used by `prisma migrate`. Set it to the same value as
# DATABASE_URL unless your provider gives you a separate direct URL (Neon and
# Supabase do — use their "direct" / session connection string here).
DIRECT_DATABASE_URL=postgresql://proslink:change-me@localhost:5432/proslink?schema=public
# Used only by docker-compose.yml for the bundled database container.
POSTGRES_USER=proslink
POSTGRES_PASSWORD=
POSTGRES_DB=proslink

# --- Cache (Redis) ----------------------------------------------------------
# Optional. Without it, rate limits are kept in each server's memory — fine for
# one server; set Redis when running more than one instance.
REDIS_URL=

# --- Authentication ---------------------------------------------------------
# Required in production: at least 32 random characters. The server refuses to
# start with the development default. Generate one with: openssl rand -base64 48
JWT_SECRET=
JWT_EXPIRES_IN=7d
# Rounds for bcrypt password hashing (8–15).
BCRYPT_ROUNDS=12

# --- AI provider ------------------------------------------------------------
# Optional. Without a provider the assistant still runs every menu, catalogue
# view and request form, and hands open questions to the team.
#   claude  -> Anthropic Claude API            (default)
#   openai  -> OpenAI-compatible API           (OpenAI, Azure OpenAI, Together, etc.)
#   ollama  -> Local Ollama (OpenAI-compatible endpoint, set OPENAI_BASE_URL)
#   gemini  -> Google Gemini API
AI_PROVIDER=claude
# Model id for the selected provider. Empty uses the provider's default.
AI_MODEL=
# Optional smaller model for reading customer details out of each message.
AI_EXTRACTION_MODEL=
# Response length cap.
AI_MAX_TOKENS=1400
# Optional Claude extended thinking (slower). Keep false for a responsive chat.
AI_THINKING=false

# Anthropic (claude)
ANTHROPIC_API_KEY=
# Claude Platform on AWS only; leave empty for Anthropic's own API.
ANTHROPIC_BASE_URL=
ANTHROPIC_WORKSPACE_ID=

# OpenAI-compatible (openai / ollama)
OPENAI_API_KEY=
# Override for Azure/Together/OpenRouter/Ollama, e.g. http://localhost:11434/v1
OPENAI_BASE_URL=https://api.openai.com/v1

# Google Gemini (gemini)
GEMINI_API_KEY=
GEMINI_THINKING=

# --- WhatsApp Business Cloud API (Meta) -------------------------------------
# Powers the WhatsApp assistant, staff replies, templates and broadcasts.
# Meta's names (below) and the older short names are both accepted:
#   WHATSAPP_PHONE_NUMBER_ID  = WHATSAPP_PHONE_ID
#   WHATSAPP_ACCESS_TOKEN     = WHATSAPP_TOKEN
#   WHATSAPP_BUSINESS_ACCOUNT_ID = WHATSAPP_WABA_ID
#
# 1. Phone number ID of the Pros-Link business number (Meta ▸ WhatsApp ▸ API
#    Setup — a numeric id, not the phone number itself).
WHATSAPP_PHONE_NUMBER_ID=
# 2. Permanent access token from a System User with `whatsapp_business_messaging`
#    (and `whatsapp_business_management` to manage templates from the console).
#    Temporary tokens expire after 24 hours.
WHATSAPP_ACCESS_TOKEN=
# 3. Any random string you invent; type the same value into Meta's webhook form
#    as the "Verify token". e.g. openssl rand -hex 16
WHATSAPP_VERIFY_TOKEN=
# 4. App secret (Meta ▸ App settings ▸ Basic). Every inbound webhook is signed
#    with it; without it the webhook refuses all deliveries.
WHATSAPP_APP_SECRET=
# 5. WhatsApp Business Account ID — needed to sync and create templates.
WHATSAPP_BUSINESS_ACCOUNT_ID=
# Graph API version used for outbound calls.
WHATSAPP_API_VERSION=v21.0
# Set false to keep the number connected but stop the assistant replying.
WHATSAPP_AUTO_REPLY=true
#
# Webhook callback URL to register in Meta (subscribe to the `messages` field):
#   https://ai.pros-link.com/webhook
# `/webhook` is rewritten to /api/whatsapp/webhook, so either path works.
# Admin ▸ WhatsApp shows the exact URL derived from APP_URL.

# --- Email notifications (optional) -----------------------------------------
# In-app notifications work without these. New leads, quote requests and
# tickets are also queued as email rows in the `notifications` table for the
# team inbox; this app does not send them itself — run a mail worker that
# delivers QUEUED EMAIL rows with these settings (see docs/DEPLOYMENT.md).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# e.g. "Pros-Link <no-reply@your-domain>"
SMTP_FROM=
# Inbox for team notifications when a team in Chatbot Studio ▸ Teams has none.
SALES_NOTIFY_EMAIL=

# SMS gateway (optional)
SMS_API_KEY=
SMS_SENDER_ID=

# Google Maps (optional)
GOOGLE_MAPS_API_KEY=

# --- Scheduled jobs ---------------------------------------------------------
# Secret for /api/cron/follow-ups. Call it every 15–30 minutes with
# `Authorization: Bearer <CRON_SECRET>`. Unset, follow-ups are off.
# Generate one with: openssl rand -hex 32
CRON_SECRET=

# --- First Super Admin ------------------------------------------------------
# Used by `npm run db:seed` to create the first Super Admin. Everyone else is
# added in Admin ▸ Team. The password needs 10+ characters with a letter and a
# number. An existing account's password is never reset by the seed.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
SEED_ADMIN_NAME="Pros-Link Administrator"

# --- Branding (optional, public) --------------------------------------------
# A logo image to use instead of the built-in mark (a path under /public or a
# full https URL). The company profile's logo, when set, is used on the site.
NEXT_PUBLIC_BRAND_LOGO_URL=
# Optional "built by" credit in the footer. Leave empty for none.
NEXT_PUBLIC_CREDIT_NAME=
NEXT_PUBLIC_CREDIT_URL=

# --- Build (only on memory-constrained shared hosts) -------------------------
# LOW_MEMORY_BUILD=1
